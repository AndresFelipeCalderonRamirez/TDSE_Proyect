# =============================================================================
# WaterTwinML — Environment Variables (.env.example)
# Copy to .env and fill in your values before running Docker containers
# =============================================================================
#   cp .env.example .env
#   docker compose up -d dashboard
# =============================================================================

# ── AWS Configuration ──────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
LAB_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/LabRole

# ── DynamoDB ───────────────────────────────────────────────────────────────────
DYNAMO_TABLE=water-twin-data

# ── S3 ─────────────────────────────────────────────────────────────────────────
MODEL_BUCKET=water-twin-ACCOUNT_ID

# ── Kinesis Streams ────────────────────────────────────────────────────────────
TENANT_A_STREAM=tenant-a-stream
TENANT_B_STREAM=tenant-b-stream

# ── Lambda Functions ───────────────────────────────────────────────────────────
ANOMALY_LAMBDA=water-twin-anomaly
PREDICTION_LAMBDA=water-twin-prediction
DIGITAL_TWIN_LAMBDA=water-twin-digital-twin

# ── Lambda Layers ──────────────────────────────────────────────────────────────
SKLEARN_LAYER_ARN=
NETWORKX_LAYER_ARN=

# ── Model Training ─────────────────────────────────────────────────────────────
ISOLATION_FOREST_CONTAMINATION=0.02
ISOLATION_FOREST_N_ESTIMATORS=100
ANOMALY_THRESHOLD=0.65

# ── Digital Twin ───────────────────────────────────────────────────────────────
RISK_PROPAGATION_ALPHA=0.7
RANKING_TOP_K=5
RISK_WINDOW_HOURS=2

# ── Simulation ─────────────────────────────────────────────────────────────────
ANOMALY_RATE=0.02
ANOMALY_DURATION_SECONDS=10
SIMULATION_FREQUENCY_HZ=1.0
PREDICTION_BATCH_SIZE=100

# ── Tenant Configuration ───────────────────────────────────────────────────────
TENANT_A_SEGMENTS=50
TENANT_B_SEGMENTS=40
TENANT_A_ALTITUDE=2600
TENANT_B_ALTITUDE=1500
